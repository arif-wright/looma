# Share this server-side secret with SvelteKit. Never prefix it PUBLIC_ or expose it to the browser.
WORLD_JOIN_SECRET=replace-with-at-least-32-random-characters
PORT=2567
WORLD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WORLD_PING_INTERVAL_MS=10000
WORLD_PING_MAX_RETRIES=3
WORLD_LOG_LEVEL=info
WORLD_RECONNECT_GRACE_SECONDS=20
WORLD_MAX_CLIENTS=32
WORLD_MAP_ID=wilds-exploration
WORLD_CHECKPOINT_SECONDS=15

# Server only. Use a dedicated project/environment and never expose this key to the browser.
WORLD_SUPABASE_URL=https://your-project.supabase.co
WORLD_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
