{
	"name": "looma-web",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=20.19.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:e2e": "dotenv -e .env.local -- vite preview --port 4173 --host 0.0.0.0",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:core": "svelte-kit sync && tsc -p ./tsconfig.core.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:e2e": "playwright test --reporter=list",
		"test:world-assets": "node --test scripts/world/muse-assets.test.mjs scripts/world/environment-assets.test.mjs",
		"world:muse:validate": "node scripts/world/muse-assets.mjs validate",
		"world:muse:ingest": "node scripts/world/muse-assets.mjs ingest",
		"world:muse:pack": "node scripts/world/muse-assets.mjs pack",
		"world:echo:validate": "node scripts/world/muse-assets.mjs validate --source art-source/world/companions/echo/production/v1",
		"world:echo:ingest": "node scripts/world/muse-assets.mjs ingest --source art-source/world/companions/echo/production/v1",
		"world:echo:pack": "node scripts/world/muse-assets.mjs pack --source art-source/world/companions/echo/production/v1 --output artifacts/world/companions/echo/v1",
		"world:player:male:validate": "node scripts/world/muse-assets.mjs validate --source art-source/world/players/male/production/v1",
		"world:player:male:ingest": "node scripts/world/muse-assets.mjs ingest --source art-source/world/players/male/production/v1",
		"world:player:male:pack": "node scripts/world/muse-assets.mjs pack --source art-source/world/players/male/production/v1 --output artifacts/world/players/male/v1",
		"world:player:female:validate": "node scripts/world/muse-assets.mjs validate --source art-source/world/players/female/production/v1",
		"world:player:female:ingest": "node scripts/world/muse-assets.mjs ingest --source art-source/world/players/female/production/v1",
		"world:player:female:pack": "node scripts/world/muse-assets.mjs pack --source art-source/world/players/female/production/v1 --output artifacts/world/players/female/v1",
		"world:environment:validate": "node scripts/world/environment-assets.mjs validate",
		"world:environment:prepare": "node scripts/world/environment-assets.mjs prepare",
		"seed": "tsx scripts/seed.ts",
		"seed:ci": "NODE_ENV=test tsx scripts/seed.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.48.0",
		"@sveltejs/adapter-vercel": "^5.5.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/three": "0.172.0",
		"autoprefixer": "^10.4.21",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"pngjs": "5.0.0",
		"postcss": "^8.5.6",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^3.4.14",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^1.5.0"
	},
	"dependencies": {
		"@colyseus/sdk": "0.17.43",
		"@google/model-viewer": "^4.0.0",
		"@supabase/ssr": "^0.5.0",
		"@supabase/supabase-js": "^2.46.0",
		"@vercel/og": "^0.8.5",
		"canvas-confetti": "^1.9.4",
		"emoji-picker-element": "^1.29.1",
		"lucide-svelte": "^0.552.0",
		"phaser": "^3.80.0",
		"qrcode": "^1.5.4",
		"sortablejs": "^1.15.6",
		"stripe": "^14.25.0",
		"three": "0.172.0",
		"ua-parser-js": "^1.0.41",
		"zod": "^3.23.8"
	}
}
